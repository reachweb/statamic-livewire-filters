diff --git a/src/Http/Livewire/LfCount.php b/src/Http/Livewire/LfCount.php
--- a/src/Http/Livewire/LfCount.php
+++ b/src/Http/Livewire/LfCount.php
@@ -2,7 +2,6 @@
 
 namespace Reach\StatamicLivewireFilters\Http\Livewire;
 
-use Livewire\Attributes\On;
 use Livewire\Component;
 
 class LfCount extends Component
@@ -11,10 +10,36 @@
 
     public $view = 'count';
 
-    #[On('entries-updated')]
+    /**
+     * The bundled view updates itself from the browser event, so no round trip is
+     * needed; a customized view (custom `view=` or a published count.blade.php that
+     * predates this) keeps the server listener.
+     */
+    protected function getListeners()
+    {
+        return $this->countViewIsCustomized() ? ['entries-updated' => 'updatedCount'] : [];
+    }
+
     public function updatedCount($count)
     {
         $this->count = $count;
+    }
+
+    protected function countViewIsCustomized(): bool
+    {
+        if ($this->view !== 'count') {
+            return true;
+        }
+
+        try {
+            $path = view()->getFinder()->find('statamic-livewire-filters::livewire.ui.count');
+        } catch (\Throwable $exception) {
+            return true;
+        }
+
+        $bundled = realpath(__DIR__.'/../../../resources/views');
+
+        return $bundled === false || ! str_starts_with(realpath($path) ?: $path, $bundled);
     }
 
     public function render()
